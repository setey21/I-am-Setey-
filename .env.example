# Copy these names into Vercel Project Settings > Environment Variables.
# Never commit real values or expose them through VITE_* variables.
ADMIN_PASSWORD=replace-with-a-long-random-password-at-least-20-characters
SESSION_SECRET=replace-with-a-random-secret-at-least-32-characters
RESEND_API_KEY=replace-with-your-resend-api-key
RESEND_FROM_EMAIL="Portfolio Contact <contact@your-verified-domain.com>"
